# Optional note suggestion provider configuration.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Optional local model setup. Keep this inside the project for portability.
FILE_MEMORY_MODEL_DIR=.models
FILE_MEMORY_OFFLINE_MODE=1

# Optional desktop update manifest override. The production default is:
# https://updates.usmanautomates.com/file-memory/latest.json
FILE_MEMORY_UPDATE_MANIFEST_URL=
